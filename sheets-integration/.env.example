# Authentication: use ONE of the two options.
# Option A (recommended for operators, SRS FR-DATA-01): OAuth with the operator's own Google account, drive.file scope.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Option B (development / platform-managed account): service account key file. Use a shared drive folder,
# because service accounts have no My Drive storage of their own.
GOOGLE_APPLICATION_CREDENTIALS=

# Drive folder that will hold the operator's spreadsheets (setup:google creates them here).
DRIVE_FOLDER_ID=

# Spreadsheet ids printed by `npm run setup:google`.
SHEET_CONFIG_ID=
SHEET_TRANSACTIONS_ID=
SHEET_GUEST_ID=
SHEET_AUDIT_ID=

# Secret key for handover PIN hashing (HMAC, SRS NFR-SEC-01). Keep it out of the spreadsheets.
PIN_HMAC_SECRET=change-me
