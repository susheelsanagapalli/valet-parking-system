{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w sheets-integration && npm run build -w web",
  "outputDirectory": "web/dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "production": true
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://valetpay.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
