PORT=8080
# Public address of the web app, used in guest ticket links.
PUBLIC_BASE_URL=http://localhost:5173

# memory = demo data in memory (lost on restart); google = the operator's Google Sheets.
STORE=memory
# Load demo locations, users and two parked cars, and show the Test credentials panel on the
# sign-in page. Must be false in production (NODE_ENV=production refuses to start otherwise).
SEED_DEMO=true

# Required in production: long random values.
AUTH_SECRET=change-me
PIN_HMAC_SECRET=change-me

# First staff accounts (JSON file made with "npm run staff-user"); needed for the first production
# start. Accounts and roles changed in the app are then saved to DATA_DIR/staff.json, which wins.
# Without it, demo users are created when SEED_DEMO=true.
STAFF_USERS_FILE=
# Folder for files the server writes (staff.json, Google connection, SMS settings, uploads).
# DATA_DIR=/var/data

# Guest SMS from your own mobile number, through an Android phone with that SIM (see README):
#   manual   – tap-to-send from the staff phone, works on iPhone (default)
#   log      – print messages to the console and the Test credentials panel
#   smsgate  – "SMS Gateway for Android" app (free, open source): https://sms-gate.app
#   httpsms  – "httpSMS" app (free plan with a monthly limit): https://httpsms.com
#   off      – no SMS
# Settings saved in the admin panel (Settings → Guest SMS) override this.
SMS_PROVIDER=manual
SMS_FROM=+919515858993
# smsgate: username and password shown in the app. Cloud URL below; for the phone's local
# server use http://<phone-ip>:8080/message instead.
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1/message
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# httpsms: API key from https://httpsms.com/settings; SMS_FROM must be the number registered in the app.
HTTPSMS_API_KEY=

# Photo storage: local (uploads/ folder) or google_drive (DRIVE_PHOTO_FOLDER_ID).
PHOTO_STORAGE=local
DRIVE_PHOTO_FOLDER_ID=

# Google Sheets (STORE=google); see sheets-integration/README.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
SHEET_CONFIG_ID=
SHEET_TRANSACTIONS_ID=
SHEET_GUEST_ID=
SHEET_AUDIT_ID=
