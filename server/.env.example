PORT=8080
# Public address of the web app, used in guest ticket links.
PUBLIC_BASE_URL=http://localhost:5173

# memory = demo data in memory (lost on restart); google = the operator's Google Sheets.
STORE=memory
# Load demo locations and users when the store is empty.
SEED_DEMO=true

# Required in production: long random values.
AUTH_SECRET=change-me
PIN_HMAC_SECRET=change-me

# Staff accounts (JSON file). Without it, demo users are created when SEED_DEMO=true.
STAFF_USERS_FILE=

# Photo storage: local (uploads/ folder) or google_drive (DRIVE_PHOTO_FOLDER_ID).
PHOTO_STORAGE=local
DRIVE_PHOTO_FOLDER_ID=

# Google Sheets (STORE=google); see sheets-integration/README.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
SHEET_CONFIG_ID=
SHEET_TRANSACTIONS_ID=
SHEET_GUEST_ID=
SHEET_AUDIT_ID=
